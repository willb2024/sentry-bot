// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


model Trade {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields:[userId], references: [id])
  tokenAddress     String
  isBuy            Boolean
  amountInSol      Float
  feeChargedSol    Float    
  affiliateCutSol  Float    @default(0.0)
  loyaltyRebateSol Float    @default(0.0)
  txSignature      String   
  status           String   @default("CONFIRMED") 
  profitPercent    Float?   @default(0)
  realizedPnlSol   Float?   @default(0)
  
  strategy         String   @default("Manual / Direct")
  aiScore          Int?     
  expectedPriceUsd Float?
  executedPriceUsd Float?   @default(0)
  slippagePercent  Float?

  createdAt        DateTime @default(now())

  @@index([userId, status])
  @@index([userId, tokenAddress, isBuy, status])
  @@index([txSignature])
}

model SimTrade {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  tokenAddress    String
  isBuy           Boolean
  amountInSol     Float
  profitPercent   Float?
  realizedPnlSol  Float?
  strategy        String    @default("Manual / Direct")
  createdAt       DateTime  @default(now())
  simStateId      String?
  simState        SimState? @relation(fields: [simStateId], references: [id])

  @@index([userId, isBuy])
}

model SimState {
  id                      String     @id @default(uuid())
  userId                  String     @unique
  user                    User       @relation(fields: [userId], references: [id])
  balance                 Float      @default(0.0)
  startingBalance         Float      @default(0.0)
  volume                  Float      @default(0.0)
  credits                 Int        @default(0)
  active                  Boolean    @default(false)
  autoSnipeActive         Boolean    @default(false)
  positions               Json?      
  
  maxBudgetSol            Float?     
  sessionSpendSol         Float?     

  // Forged stats overrides
  forgedSharpe            Float?
  forgedDrawdown          Float?
  forgedProfit            Float?
  forgedRisk              Float?
  forged24hTrades         Int?
  forged24hPnl            Float?
  forgedManual24hCount    Int?
  forgedManual24hPnl      Float?
  forgedAuto24hCount      Int?
  forgedAuto24hPnl        Float?
  forgedHourlyChart       Json?
  forgedStrat1Name        String?
  forgedStrat1Pnl         Float?
  forgedStrat2Name        String?
  forgedStrat2Pnl         Float?

  // Forged Affiliate additions
  forgedPendingRewardsSol Float?
  forgedLifetimeEarnedSol Float?
  forgedTotalPoints       Int?
  forgedTier              String?
  forgedCopierYieldSol    Float?
  forgedRecruitCount      Int?

  updatedAt               DateTime   @updatedAt
  trades                  SimTrade[]
}

// 🔴 Idempotent Payout Ledger
model PayoutRecord {
  id         String   @id @default(uuid())
  userId     String
  amountSol  Float
  signature  String?  @unique
  status     String   @default("PENDING") // PENDING | CONFIRMED | FAILED | REFUNDED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, status])
}


model GuardRecommendation {
  id                 String   @id @default(uuid())
  telegramId         String
  tokenAddress       String
  tokenSymbol        String
  score              Int
  trailingDrop       Float
  takeProfit         Float
  ageMins            Float
  liquidity          Float
  volume24h          Float
  priceChangeM5      Float
  hasSocials         Boolean
  isRug              Boolean
  lpLockPct          Float
  velocityGrowth     Float
  sentiment          Float
  predictedRange     String
  timeframe          String
  confidence         String
  used               Boolean  @default(false)
  outcomePnlPercent  Float?   
  outcomePeakPercent Float?   
  finalized          Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([telegramId, tokenAddress])
}

model GuardModelWeights {
  id            String   @id @default(uuid())
  version       Int      @default(1)
  trainedAt     DateTime @default(now())
  coefficients  Json
  featureNames  Json
  normalization Json?
  metrics       Json?
}



model CreditTransaction {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  type         String   // 'PURCHASE' | 'CONSUME_SCAN' | 'CONSUME_CALLER' | 'ADMIN_GRANT'
  amount       Int      // positive for purchase, negative for consume
  balanceAfter Int
  tokenMint    String?  
  packName     String?  
  txSignature  String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model ActiveOrder {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  tokenAddress      String
  orderType         String 
  amountSol         Float
  targetPriceUsd    Float?   
  trailingPercent   Float?   
  takeProfitPercent Float?   
  dcaIntervalMins   Int?     
  maxBudgetSol      Float?   
  
  maxHoldMinutes    Int?     
  maxBuys           Int?     
  strategy          String   @default("Manual / Direct") // 🟢 FUNC-2 Fix

  totalSpentSol     Float    @default(0.0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, isActive])
  @@index([tokenAddress])
}

model LaunchedToken {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields:[userId], references: [id])
  
  tokenAddress      String   @unique
  name              String
  symbol            String
  
  launchedAt        DateTime @default(now())
  devBuySol         Float
  walletCount       Int
  totalVolumeBumped Float    @default(0.0)
  
  isSimulated       Boolean  @default(false) // 🟢 FUNC-7 Fix
  isActive          Boolean  @default(true)
  
  @@index([userId])
}



// 🟢 NEW: Social Copy-Trading Network Model
model CopyTradeFollow {
  id         String   @id @default(uuid())
  leaderId   String
  leader     User     @relation("Leader", fields: [leaderId], references: [id])
  followerId String
  follower   User     @relation("Follower", fields: [followerId], references: [id])
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  @@index([leaderId, isActive]) // 🟢 ADD THIS

  @@unique([leaderId, followerId])
  @@index([leaderId])
  @@index([followerId])
}


model AutoSnipeConfig {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id])
  isActive                Boolean  @default(false)
  sniperMode              String   @default("PUMP") 
  amountSol               Float    @default(0.05)
  requireSocials          Boolean  @default(true)
  maxDevBuyPercent        Float    @default(10.0)
  autoTrailingDropPercent Float    @default(20.0) 
  useDeepScoring          Boolean  @default(false)
  autoTakeProfitPercent   Float?
  minScore                Int      @default(0) 
  minMarketCap            Float    @default(0.0)
  maxMarketCap            Float    @default(100000.0)
  antiDeadCoin            Boolean  @default(false)
  maxBudgetSol            Float?   
  maxLossPercent          Float?   // 🟢 Circuit breaker: -% drop threshold from starting balance
  totalSpentSol           Float    @default(0.0)
  snipeDelaySeconds       Int      @default(0) 

  // Conviction-Weighted Dynamic Scaling Fields
  enableDynamicScaling    Boolean  @default(false)
  baseRiskUnitSol         Float    @default(0.02)
  maxRiskMultiplier       Float    @default(5.0)
  scaleExponent           Float    @default(2.0)

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model CopyTradeConfig {
  id                      String   @id @default(uuid())
  userId                  String   
  user                    User     @relation(fields: [userId], references: [id])
  targetWallet            String   
  tradeAmountSol          Float    @default(0.1) 
  autoTrailingDropPercent Float    @default(20.0) 
  autoTakeProfitPercent   Float?                  
  
  copyBuys                Boolean  @default(true)
  copySells               Boolean  @default(true)
  maxTradeSizeSol         Float?   
  slippagePercent         Float?   

  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([targetWallet])
  @@index([userId])
}

model Guild {
  id                String            @id @default(uuid())
  ownerId           String            @unique          
  owner             User              @relation("GuildOwner", fields: [ownerId], references: [id])
  guildCode         String            @unique          
  name              String                             
  description       String?                            
  rewardDescription String?                           
  feePaidSol        Float             @default(2.0)
  isActive          Boolean           @default(true)
  members           GuildMembership[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([guildCode])
}

model User {
  id                    String   @id @default(uuid())
  telegramId            String   @unique
  username              String?
  
  autoSnipeConfig       AutoSnipeConfig?
  firstTradeAt          DateTime?
  
  activeWallets         Int      @default(1)
  vault2                String?  @unique
  pk2                   String?  @unique
  vault3                String?  @unique
  pk3                   String?  @unique
  vault4                String?  @unique
  pk4                   String?  @unique
  vault5                String?  @unique
  pk5                   String?  @unique

  @@index([vaultAddress])   // 🟢 ADD THIS
  @@index([activeWallets])  // 🟢 ADD THIS

  priorityLevel         String   @default("FAST") 
  customPriorityFee     Float    @default(0.001) 

  ownedGuild            Guild?            @relation("GuildOwner")
  guildMemberships      GuildMembership[] @relation("GuildMembers") // 🟢 Exact match with GuildMembership.user

  vaultAddress          String?  @unique
  wasEverPromoGranted   Boolean  @default(false)
  turnkeySubOrgId       String?  @unique

  referralCode          String   @unique
  referredById          String?  
  referredBy            User?    @relation("AffiliateTree", fields: [referredById], references: [id])
  recruits              User[]   @relation("AffiliateTree")

  totalVolumeSol        Float    @default(0.0) 
  isLoyaltyUnlocked     Boolean  @default(false) 
  hasReferralDiscount   Boolean  @default(false) 

  enableSOR             Boolean  @default(true)
  enableAdaptiveSlippage Boolean @default(true)

  isVip                 Boolean   @default(false)
  vipTier               String?
  vipExpiresAt          DateTime?
  vipSource             String?
  vipTxSignature        String?
  vipPurchasedAt        DateTime?
  isDevSuiteUnlocked    Boolean   @default(false)
  
  withdrawalPin         String?   
  withdrawalPinRecovery String?   
  
  slippagePercent       Float    @default(20.0)
  pendingRewardsSol     Float    @default(0.0)
  lifetimeEarnedSol     Float    @default(0.0)

  creditBalance         Int      @default(25)  
  lifetimeCredits       Int      @default(25)
  creditTxs             CreditTransaction[]

  reactionGifsEnabled   Boolean  @default(true)

  trades                Trade[]
  activeOrders          ActiveOrder[] 
  copyTrades            CopyTradeConfig[] 
  launchedTokens        LaunchedToken[] 
  affiliateEarnings     AffiliateEarning[]

  followedBy            CopyTradeFollow[] @relation("Leader")
  following             CopyTradeFollow[] @relation("Follower")

  simState              SimState?
  simTrades             SimTrade[]

  webhookConfigs        WebhookConfig[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([telegramId])
  @@index([referralCode])
}

model GuildMembership {
  id                  String   @id @default(uuid())
  guildId             String
  guild               Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId              String
  user                User     @relation("GuildMembers", fields: [userId], references: [id], onDelete: Cascade) // 🟢 Exact match with User.guildMemberships
  loyaltyPoints       Float    @default(0.0)   
  totalVolumeSol      Float    @default(0.0)   
  simLoyaltyPoints    Float    @default(0.0)
  simTotalVolumeSol   Float    @default(0.0)
  rank                Int?                            
  airdropsReceivedSol Float    @default(0.0)
  isActive            Boolean  @default(true) 
  joinedAt            DateTime @default(now())
  lastActiveAt        DateTime @default(now())

  @@unique([guildId, userId])               
  @@index([guildId, loyaltyPoints])
}

model AffiliateEarning {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountSol   Float
  source      String   // 'TRADE_FEE' | 'CREDIT' | 'COPY'
  fromUser    String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model DailyVipPromo {
  id          String   @id @default(uuid())
  date        String   @unique  
  slotsUsed   Int      @default(0)
  maxSlots    Int      @default(10)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model CallerPrediction {
  id                String   @id @default(uuid())
  alertKey          String   @unique   
  mint              String
  symbol            String
  score             Int
  ageMins           Float
  liquidity         Float
  volume24h         Float
  priceChangeM5     Float
  hasSocials        Boolean
  isRug             Boolean?
  sourceQuality     String?
  devLaunchCount    Int?
  lpLockPct         Float?
  velocityGrowth    Float?
  predictedLow      Float
  predictedHigh     Float
  predictedTimeMins Float
  alertedAt         DateTime
  finalized         Boolean  @default(false)
  peakPct           Float?   
  peakAtMs          Int?     
  outcome1h         Float?
  outcome6h         Float?
  outcome24h        Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CallerModelWeights {
  id          String   @id @default(uuid())
  version     Int      @default(1)
  trainedAt   DateTime @default(now())
  coefficients Json     
  featureNames Json     
  metrics     Json?    
}

model WebhookConfig {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  url         String
  events      String[] 
  secretKey   String?  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([userId])
}